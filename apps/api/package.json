{
  "name": "@evalot/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --platform=node --format=esm --external:express --external:pg --external:helmet --external:zod --external:multer --external:pdf-lib --external:sharp --external:pdfjs-dist/* --outdir=dist",
    "start": "node --env-file=../../.env dist/server.js",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@evalot/contracts": "0.1.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.16.3",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.25.12"
  }
}
