DATABASE_URL=postgres://evalot:evalot_local@localhost:55432/evalot
PORT=4000
# Teachers create their own accounts in the app. No default password.
AUTH_MODE=password
APP_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173

# Add your own provider settings here, never in the chat.
APP_PUBLIC_URL=http://127.0.0.1:5174
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback
# Password recovery email adapter: Resend verified sender
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI drafting. Choose a Responses-compatible vision model.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional handwriting/marking vision adapter; requires a vision Responses model.
OPENAI_VISION_MODEL=

# Local OpenCV processor: Python executable with modules in .data/opencv-runtime
OPENCV_PYTHON=

# Gemini takes precedence when configured; key stays backend-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Hosted API only; configure these in the backend host dashboard.
# NODE_ENV=production
# HOST=0.0.0.0
# UPLOAD_STORAGE_ROOT=/var/data/evalot/uploads
# APP_PUBLIC_URL=https://your-project.vercel.app
# APP_ORIGINS=https://your-project.vercel.app
# GOOGLE_REDIRECT_URI=https://your-project.vercel.app/api/auth/google/callback

# Optional local OCR: absolute path to the installed CPU Python environment.
OCR_PYTHON=
